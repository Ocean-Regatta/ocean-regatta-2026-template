<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="flat_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <scene>
      <grid>false</grid>
      <ambient>0.6 0.6 0.6 1.0</ambient>
      <background>0.8 0.85 0.9 1.0</background>
    </scene>

    <!-- Simulation Plugins -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>

    <!-- GUI Configuration -->
    <gui fullscreen="0">
      <plugin filename="MinimalScene" name="3D View">
        <gz-gui>
          <title>3D View</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.5 0.5 0.5</ambient_light>
        <background_color>0.8 0.85 0.9</background_color>
        <!-- View centered around the BlueBoat -->
        <camera_pose>-4.0 -3.0 2.2 0 0.35 0.65</camera_pose>
      </plugin>

      <plugin filename="GzSceneManager" name="Scene Manager">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>

      <plugin filename="WorldControl" name="World control">
        <gz-gui>
          <title>World control</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">72</property>
          <property type="double" key="width">121</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="left" target="left"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </gz-gui>
        <play_pause>true</play_pause>
        <step>true</step>
        <start_paused>false</start_paused>
      </plugin>

      <plugin filename="WorldStats" name="World stats">
        <gz-gui>
          <title>World stats</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">72</property>
          <property type="double" key="width">290</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="right" target="right"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </gz-gui>
        <sim_time>true</sim_time>
        <real_time>true</real_time>
        <real_time_factor>true</real_time_factor>
        <iterations>true</iterations>
      </plugin>
    </gui>

    <!-- Hydrostatic Buoyancy System (waterline at Z = 0) -->
    <plugin filename="gz-sim-buoyancy-system" name="gz::sim::systems::Buoyancy">
      <graded_buoyancy>
        <default_density>1000.0</default_density>
        <density_change>
          <above_depth>0</above_depth>
          <density>1.2</density>
        </density_change>
      </graded_buoyancy>
      <enable>blueboat</enable>
    </plugin>

    <!--
      NOTE:
      libwave_simulation_system.so is intentionally omitted here.
      This ensures:
      1. Zero Gerstner wave displacement (flat water surface).
      2. Zero wave-induced dynamic heave forces.
      3. Zero wave-induced pitch and roll excitation moments.
      4. Zero ocean stream current velocity / drift.
    -->

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>48.0</latitude_deg>
      <longitude_deg>-4.5</longitude_deg>
      <elevation>0.0</elevation>
      <heading_deg>0.0</heading_deg>
    </spherical_coordinates>

    <!-- Sun Directional Light -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 50 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.5 0.2 -1.0</direction>
    </light>

    <!-- Flat Calm Ocean Surface (Visual water plane with reflection & refraction, no wave deformation) -->
    <include>
      <uri>model://flat_ocean</uri>
      <name>flat_ocean</name>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- Procedural Seafloor (Sand and Rocks) -->
    <include>
      <uri>model://seafloor</uri>
      <name>seafloor</name>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- BlueBoat USV Model positioned at spawn origin -->
    <include>
      <uri>model://blueboat</uri>
      <name>blueboat</name>
      <pose>0 0 0.05 0 0 0</pose>
    </include>

    <!-- Visual Tuning Reference Markers (Spaced along the course for speed & turning radius benchmarking) -->
    <!-- Reference Gate 1: 25 m ahead -->
    <model name="tuning_marker_25m_port">
      <static>true</static>
      <pose>25.0 5.0 0.4 0 0 0</pose>
      <link name="link">
        <visual name="body">
          <geometry><cylinder><radius>0.2</radius><length>0.8</length></cylinder></geometry>
          <material><ambient>0.9 0.1 0.1 1</ambient><diffuse>0.9 0.1 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="tuning_marker_25m_starboard">
      <static>true</static>
      <pose>25.0 -5.0 0.4 0 0 0</pose>
      <link name="link">
        <visual name="body">
          <geometry><cone><radius>0.25</radius><length>0.8</length></cone></geometry>
          <material><ambient>0.1 0.8 0.1 1</ambient><diffuse>0.1 0.8 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Reference Gate 2: 50 m ahead -->
    <model name="tuning_marker_50m_port">
      <static>true</static>
      <pose>50.0 5.0 0.4 0 0 0</pose>
      <link name="link">
        <visual name="body">
          <geometry><cylinder><radius>0.2</radius><length>0.8</length></cylinder></geometry>
          <material><ambient>0.9 0.1 0.1 1</ambient><diffuse>0.9 0.1 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="tuning_marker_50m_starboard">
      <static>true</static>
      <pose>50.0 -5.0 0.4 0 0 0</pose>
      <link name="link">
        <visual name="body">
          <geometry><cone><radius>0.25</radius><length>0.8</length></cone></geometry>
          <material><ambient>0.1 0.8 0.1 1</ambient><diffuse>0.1 0.8 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Reference Gate 3: 100 m ahead -->
    <model name="tuning_marker_100m_port">
      <static>true</static>
      <pose>100.0 5.0 0.4 0 0 0</pose>
      <link name="link">
        <visual name="body">
          <geometry><cylinder><radius>0.2</radius><length>0.8</length></cylinder></geometry>
          <material><ambient>0.9 0.1 0.1 1</ambient><diffuse>0.9 0.1 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="tuning_marker_100m_starboard">
      <static>true</static>
      <pose>100.0 -5.0 0.4 0 0 0</pose>
      <link name="link">
        <visual name="body">
          <geometry><cone><radius>0.25</radius><length>0.8</length></cone></geometry>
          <material><ambient>0.1 0.8 0.1 1</ambient><diffuse>0.1 0.8 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>

