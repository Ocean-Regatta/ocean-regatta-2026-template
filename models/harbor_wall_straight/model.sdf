<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="harbor_wall_straight">
    <static>true</static>
    <link name="quay_link">
      <!-- Main Analytical Collision Box (Guarantees zero physics glitches and sharp Ping2 GPU LiDAR returns) -->
      <collision name="quay_collision">
        <pose>0.0 -2.2500 -7.1000 0 0 0</pose>
        <geometry>
          <box>
            <size>55.0000 4.5000 18.2000</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.9</mu>
              <mu2>0.9</mu2>
            </ode>
          </friction>
          <contact>
            <ode>
              <kp>10000000.0</kp>
              <kd>1.0</kd>
            </ode>
          </contact>
        </surface>
      </collision>

      <!-- High-Fidelity Photorealistic Visual Mesh -->
      <visual name="quay_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://harbor_wall_straight/meshes/harbor_wall_straight.obj</uri>
          </mesh>
        </geometry>
      </visual>
    </link>
  </model>
</sdf>
