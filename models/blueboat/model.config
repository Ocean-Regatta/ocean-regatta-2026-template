<?xml version="1.0"?>
<model>
  <name>blueboat</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>Ocean Regatta Organizers</name>
    <email>organizers@ocean-regatta.org</email>
  </author>
  <description>
    Blue Robotics BlueBoat Catamaran autonomous surface vehicle model
    configured for the Ocean Regatta competition with differential thrusters,
    Fossen hydrodynamic damping, buoyancy, IMU, GPS, contact sensor, and
    port-side Ping2 single-beam acoustic sonar.
  </description>
</model>
