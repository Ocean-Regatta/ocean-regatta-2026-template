<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="cardinal_south">
    <static>true</static>
    <link name="link">
      <!-- Mast Top (Yellow) -->
      <collision name="mast_top_collision">
        <pose>0 0 0.375 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.35</radius>
            <length>0.75</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="mast_top">
        <pose>0 0 0.375 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.35</radius>
            <length>0.75</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.85 0.75 0.05 1</ambient>
          <diffuse>0.95 0.85 0.05 1</diffuse>
        </material>
      </visual>

      <!-- Mast Bottom (Black) -->
      <collision name="mast_bottom_collision">
        <pose>0 0 -0.375 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.35</radius>
            <length>0.75</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="mast_bottom">
        <pose>0 0 -0.375 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.35</radius>
            <length>0.75</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>

      <!-- Topmark Cones (Both pointing DOWN) -->
      <visual name="cone_lower">
        <pose>0 0 1.0 0 3.14159265359 0</pose>
        <geometry>
          <cone>
            <radius>0.18</radius>
            <length>0.25</length>
          </cone>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>

      <visual name="cone_upper">
        <pose>0 0 1.3 0 3.14159265359 0</pose>
        <geometry>
          <cone>
            <radius>0.18</radius>
            <length>0.25</length>
          </cone>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>

