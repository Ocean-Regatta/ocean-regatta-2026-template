<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="seafloor">
    <static>true</static>
    <link name="seafloor_link">
      <!-- High-Fidelity Photorealistic Visual Mesh (Zero Collision Overhead) -->
      <visual name="seafloor_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://seafloor/meshes/seafloor.obj</uri>
          </mesh>
        </geometry>
      </visual>
    </link>
  </model>
</sdf>
